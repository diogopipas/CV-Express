{
  "manifest_version": 3,
  "name": "CV-Express Job Application Assistant",
  "version": "1.0.0",
  "description": "Auto-fill job applications with your CV-Express profile data",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "https://*.greenhouse.io/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.lever.co/*",
    "https://*.icims.com/*",
    "https://*.jobvite.com/*",
    "https://*.workable.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.breezy.hr/*",
    "https://jobs.lever.co/*",
    "https://boards.greenhouse.io/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.lever.co/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.workable.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.breezy.hr/*",
        "https://jobs.lever.co/*",
        "https://boards.greenhouse.io/*"
      ],
      "js": ["content/content-script.js"],
      "css": ["content/content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/*"],
      "matches": ["<all_urls>"]
    }
  ]
}

